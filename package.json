{
  "name": "frontend-fundamentals-lab",
  "version": "0.0.17",
  "description": "Daily Operating System - Productivity App with modular architecture",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "build:css": "tailwindcss -i assets/css/tailwind.input.css -o assets/css/tailwind.min.css --minify",
    "dev": "npx serve .",
    "version:sync": "node scripts/version-sync.js",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "version": "node scripts/version-sync.js && git add assets/locales/en.json assets/locales/es.json index.html CHANGELOG.md"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "jsdom": "^23.0.0",
    "tailwindcss": "^3.4.17",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "productivity",
    "javascript",
    "vanilla-js",
    "modular-architecture"
  ],
  "author": "Arturo López",
  "license": "MIT"
}
